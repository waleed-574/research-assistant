# ─── Required: LLM provider ───────────────────────────────────────────────
# Anthropic API key — powers both the Form Builder and Research agents.
# Get one at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# ─── Optional: Web search for the Research Agent ──────────────────────────
# Tavily key — gives the Research Agent real web results with source URLs.
# Free tier (1000 searches/mo) at https://app.tavily.com/
# If left blank, the app falls back to mock search results so it still runs.
TAVILY_API_KEY=

# ─── Optional: model override ─────────────────────────────────────────────
# Defaults to anthropic/claude-sonnet-4-5 if unset. Must be a value Mastra's
# model router knows; a bare name has "anthropic/" prefixed for you.
# ANTHROPIC_MODEL=anthropic/claude-sonnet-4-5

# ─── Optional: cost controls ──────────────────────────────────────────────
# Cap on the research agent's search loop. Defaults to 8; clamped to 1-20.
# This is the biggest cost lever: every step re-sends the search results
# gathered so far, so the late steps are by far the most expensive. Set it to
# 3 while working on the UI.
# RESEARCH_MAX_STEPS=3

# Serve captured fixtures instead of calling the agents — the whole flow runs
# with ZERO API calls and no key required. Ignored in production builds.
# USE_AGENT_FIXTURES=1
